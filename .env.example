# Resend credentials for the /quote contact form (app/api/quote/route.ts).
# 1. Sign up at https://resend.com and create an API key.
# 2. Verify visionprintedblinds.ca (Resend dashboard -> Domains) by adding
#    the DNS records Resend gives you (SPF/DKIM/DMARC), then you can send
#    from info@visionprintedblinds.ca below. Until the domain is verified,
#    Resend's sandbox sender (onboarding@resend.dev) only delivers to the
#    email address on your own Resend account — fine for testing, not for
#    real customer submissions.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=info@visionprintedblinds.ca

# Where quote requests get delivered. Optional — defaults to
# info@visionprintedblinds.ca if unset.
CONTACT_TO_EMAIL=info@visionprintedblinds.ca
